    "import nltk\n",
    "\n",
    "nltk.download(\"all\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "04722340",
   "metadata": {},
   "outputs": [],
   "source": [
    "# サンプルテキスト\n",
    "text = \"Natural language processing enables computers to understand human language.\"\n",
    "\n",
    "# トークン化\n",
    "tokens = nltk.word_tokenize(text)\n",
    "\n",
    "# 品詞分解\n",
    "pos_tags = nltk.pos_tag(tokens)\n",
    "\n",
    "print(pos_tags)"
   ]
